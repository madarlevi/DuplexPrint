<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Version>1.2.0</Version>
    <Description>Guided manual duplex PDF printing for Windows.</Description>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NativeWorkerDirectory>$(MSBuildProjectDirectory)\obj\native\$(Configuration)\win-x64</NativeWorkerDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(NativeWorkerDirectory)\DuplexPrint.PdfWorker.exe" Link="DuplexPrint.PdfWorker.exe"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <FileWrites Include="$(NativeWorkerDirectory)\DuplexPrint.PdfWorker.exe;$(NativeWorkerDirectory)\PdfWorker.obj" />
  </ItemGroup>
  <Target Name="BuildPdfWorker" BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(MSBuildProjectDirectory)\..\native\PdfWorker\main.cpp;$(MSBuildProjectDirectory)\..\scripts\Build-PdfWorker.ps1"
          Outputs="$(NativeWorkerDirectory)\DuplexPrint.PdfWorker.exe">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\Build-PdfWorker.ps1&quot; -OutputDirectory &quot;$(NativeWorkerDirectory)&quot;" />
  </Target>

</Project>
