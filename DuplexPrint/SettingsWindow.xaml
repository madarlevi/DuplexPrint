<Window x:Class="VirtualDuplexPrinter.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DuplexPrint · Beállítások" Width="680" Height="830" MinWidth="550" MinHeight="560"
        Background="#F3F2ED" Foreground="#192E35" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterOwner">
    <Window.Resources><ResourceDictionary Source="Design.xaml"/></Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F3F2ED">
        <StackPanel Margin="28">
            <TextBlock Text="A nyomtatódhoz igazítva." FontSize="26" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="Az új beállítás a következő feladatra érvényes. Másik tálcánál először próbálj ki négy számozott oldalt." TextWrapping="Wrap" Margin="0,0,0,20"/>
            <DockPanel Margin="0,0,0,16"><Button Content="Profil importálása…" Click="Import_Click" DockPanel.Dock="Left"/><Button Content="Profil exportálása…" Click="Export_Click" HorizontalAlignment="Right"/></DockPanel>
            <TextBlock Text="PROFIL NEVE" Style="{StaticResource Label}"/>
            <TextBox x:Name="ProfileName" Margin="0,0,0,16" MaxLength="150" AutomationProperties.Name="Profil neve"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="ELŐLAPOK SORRENDJE" Style="{StaticResource Label}"/><ComboBox x:Name="FrontOrder" SelectedIndex="0"><ComboBoxItem Content="Növekvő · 1, 3, 5…"/><ComboBoxItem Content="Csökkenő · …5, 3, 1"/></ComboBox></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="HÁTLAPOK SORRENDJE" Style="{StaticResource Label}"/><ComboBox x:Name="BackOrder" SelectedIndex="0"><ComboBoxItem Content="Növekvő · 2, 4, 6…"/><ComboBoxItem Content="Csökkenő · …6, 4, 2"/></ComboBox></StackPanel>
            </Grid>
            <CheckBox x:Name="RotateBacks" Content="Hátoldalak elforgatása 180°-kal" Margin="0,0,0,20"/>
            <TextBlock Text="PAPÍR VISSZAHELYEZÉSI ÚTMUTATÓ" Style="{StaticResource Label}"/>
            <TextBox x:Name="Instructions" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="110" MaxHeight="180" VerticalScrollBarVisibility="Auto" MaxLength="2500" Margin="0,0,0,16" AutomationProperties.Name="Visszahelyezési útmutató"/>
            <Border BorderBrush="#CCD5CE" BorderThickness="1" Background="#E8EDE7" Padding="14" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="SETTINGS.JSON" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="SettingsPath" TextWrapping="Wrap" FontSize="12"/>
                    <WrapPanel Margin="0,12,0,0"><Button Content="JSON szerkesztése" Click="EditJson_Click" Margin="0,0,8,0" Padding="10,7"/><Button Content="Újraolvasás" Click="Reload_Click" Padding="10,7"/></WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock x:Name="Status" Foreground="#A43720" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <DockPanel><Button Content="Mégse" Click="Cancel_Click" DockPanel.Dock="Left"/><Button Content="Beállítások mentése" Style="{StaticResource PrimaryButton}" Click="Save_Click" HorizontalAlignment="Right"/></DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
